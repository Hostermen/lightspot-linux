{
  "name": "spotlight-files",
  "version": "1.0.0",
  "description": "Spotlight-style launcher for Linux with app + file search",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron . --dev\"",
    "electron:build": "vite build && electron ."
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "vite": "^5.3.1",
    "wait-on": "^7.2.0"
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
